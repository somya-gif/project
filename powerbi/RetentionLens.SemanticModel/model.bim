            "sourceColumn": "year",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Calendar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/calendar.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"date\", type datetime}, {\"month\", type text}, {\"year\", Int64.Type}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": []
      },
      {
        "name": "Customers",
        "columns": [
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "first_observed_purchase",
            "dataType": "dateTime",
            "sourceColumn": "first_observed_purchase",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "cohort",
            "dataType": "string",
            "sourceColumn": "cohort",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Customers",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/customers.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"customer_id\", type text}, {\"first_observed_purchase\", type datetime}, {\"country\", type text}, {\"cohort\", type text}}, \"en-GB\")",
                "    // Anonymous invoice bucket is retained for financial reconciliation.",
                "in",
                "    Table.InsertRows(Typed, Table.RowCount(Typed), {[customer_id=\"UNKNOWN\", first_observed_purchase=null, country=\"Unknown\", cohort=\"Unknown\"]})"
              ]
            }
          }
        ],
        "measures": []
      },
      {
        "name": "Cohorts",
        "columns": [
          {
            "name": "cohort",
            "dataType": "string",
            "sourceColumn": "cohort",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "month_index",
            "dataType": "int64",
            "sourceColumn": "month_index",
            "summarizeBy": "none"
          },
          {
            "name": "active_customers",
            "dataType": "int64",
            "sourceColumn": "active_customers",
            "summarizeBy": "none"
          },
          {
            "name": "cohort_size",
            "dataType": "int64",
            "sourceColumn": "cohort_size",
            "summarizeBy": "none"
          },
          {
            "name": "retention_rate",
            "dataType": "double",
            "sourceColumn": "retention_rate",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Cohorts",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/cohort_retention.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"cohort\", type text}, {\"month\", type text}, {\"month_index\", Int64.Type}, {\"active_customers\", Int64.Type}, {\"cohort_size\", Int64.Type}, {\"retention_rate\", type number}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Cohort Retention",
            "expression": "IF(HASONEVALUE(Cohorts[month_index]), DIVIDE(SUM(Cohorts[active_customers]), SUM(Cohorts[cohort_size])))",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "Retention",
        "columns": [
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          },
          {
            "name": "active_customers",
            "dataType": "int64",
            "sourceColumn": "active_customers",
            "summarizeBy": "none"
          },
          {
            "name": "new_observed_customers",
            "dataType": "int64",
            "sourceColumn": "new_observed_customers",
            "summarizeBy": "none"
          },
          {
            "name": "returning_customers",
            "dataType": "int64",
            "sourceColumn": "returning_customers",
            "summarizeBy": "none"
          },
          {
            "name": "previous_month_customers",
            "dataType": "int64",
            "sourceColumn": "previous_month_customers",
            "summarizeBy": "none"
          },
          {
            "name": "retained_from_previous_month",
            "dataType": "int64",
            "sourceColumn": "retained_from_previous_month",
            "summarizeBy": "none"
          },
          {
            "name": "monthly_retention_rate",
            "dataType": "double",
            "sourceColumn": "monthly_retention_rate",
            "summarizeBy": "none"
          },
          {
            "name": "returning_customer_share",
            "dataType": "double",
            "sourceColumn": "returning_customer_share",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Retention",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/monthly_retention.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"month\", type text}, {\"active_customers\", Int64.Type}, {\"new_observed_customers\", Int64.Type}, {\"returning_customers\", Int64.Type}, {\"previous_month_customers\", Int64.Type}, {\"retained_from_previous_month\", Int64.Type}, {\"monthly_retention_rate\", type number}, {\"returning_customer_share\", type number}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Monthly Retention",
            "expression": "IF(HASONEVALUE(Retention[month]), DIVIDE(SUM(Retention[retained_from_previous_month]), SUM(Retention[previous_month_customers])))",
            "formatString": "0.0%"
          },
          {
            "name": "Returning Share",
            "expression": "DIVIDE(SUM(Retention[returning_customers]), SUM(Retention[active_customers]))",
            "formatString": "0.0%"
          },
          {
            "name": "New Observed Customers",
            "expression": "SUM(Retention[new_observed_customers])",
            "formatString": "#,##0"
          },
          {
            "name": "Returning Customers",
            "expression": "SUM(Retention[returning_customers])",
            "formatString": "#,##0"
          }
        ]
      },
