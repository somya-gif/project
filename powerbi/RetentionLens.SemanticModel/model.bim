        "partitions": [
          {
            "name": "Performance",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/model_performance.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"snapshot_date\", type datetime}, {\"n\", Int64.Type}, {\"positives\", Int64.Type}, {\"prevalence\", type number}, {\"average_precision\", type number}, {\"roc_auc\", type number}, {\"brier_score\", type number}, {\"precision\", type number}, {\"recall\", type number}, {\"f1\", type number}, {\"precision_at_top_10pct\", type number}, {\"lift_at_top_10pct\", type number}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Average Precision",
            "expression": "AVERAGE(Performance[average_precision])",
            "formatString": "0.000"
          },
          {
            "name": "Base Rate",
            "expression": "AVERAGE(Performance[prevalence])",
            "formatString": "0.0%"
          },
          {
            "name": "Top Decile Lift",
            "expression": "AVERAGE(Performance[lift_at_top_10pct])",
            "formatString": "0.00x"
          }
        ]
      }
    ],
