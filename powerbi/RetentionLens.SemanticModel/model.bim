        "partitions": [
          {
            "name": "Predictions",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/customer_predictions.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"customer_id\", type text}, {\"orders_lifetime\", Int64.Type}, {\"revenue_lifetime\", type number}, {\"average_order_value\", type number}, {\"country\", type text}, {\"recency_days\", type number}, {\"tenure_days\", type number}, {\"mean_gap_days\", type number}, {\"active_months\", Int64.Type}, {\"orders_30d\", Int64.Type}, {\"orders_90d\", Int64.Type}, {\"revenue_90d\", type number}, {\"is_uk\", Int64.Type}, {\"snapshot_date\", type datetime}, {\"probability\", type number}, {\"predicted_repeat\", Int64.Type}, {\"likelihood_band\", type text}, {\"model_version\", type text}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Scored Customers",
            "expression": "COUNTROWS(Predictions)",
            "formatString": "#,##0"
          },
          {
            "name": "Mean Probability",
            "expression": "AVERAGE(Predictions[probability])",
            "formatString": "0.0%"
          },
          {
            "name": "Likely Repeat Customers",
            "expression": "SUM(Predictions[predicted_repeat])",
            "formatString": "#,##0"
          },
          {
            "name": "Prediction Date",
            "expression": "MAX(Predictions[snapshot_date])",
            "formatString": "yyyy-MM-dd"
          }
        ]
      },
