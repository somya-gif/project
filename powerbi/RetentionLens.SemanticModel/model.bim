{
  "compatibilityLevel": 1600,
  "model": {
    "culture": "en-GB",
    "sourceQueryCulture": "en-GB",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "expressions": [
      {
        "name": "DataFolder",
        "kind": "m",
        "expression": "\"/workspace/scratch/79a1b3e60689/repeat_purchase/data/processed\" meta [IsParameterQuery=true, Type=\"Text\", IsParameterQueryRequired=true]"
      }
    ],
    "tables": [
      {
        "name": "Sales",
        "columns": [
          {
            "name": "order_id",
            "dataType": "string",
            "sourceColumn": "order_id",
            "summarizeBy": "none"
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none"
          },
          {
            "name": "order_date",
            "dataType": "dateTime",
            "sourceColumn": "order_date",
            "summarizeBy": "none"
          },
          {
            "name": "revenue",
            "dataType": "double",
            "sourceColumn": "revenue",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "int64",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "country",
            "dataType": "string",
            "sourceColumn": "country",
            "summarizeBy": "none"
          },
          {
            "name": "is_repeat_order",
            "dataType": "int64",
            "sourceColumn": "is_repeat_order",
            "summarizeBy": "none"
          },
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/sales_orders.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"order_id\", type text}, {\"customer_id\", type text}, {\"order_date\", type datetime}, {\"revenue\", type number}, {\"units\", Int64.Type}, {\"country\", type text}, {\"is_repeat_order\", Int64.Type}, {\"date\", type datetime}, {\"month\", type text}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Orders",
            "expression": "COUNTROWS(Sales)",
            "formatString": "#,##0"
          },
          {
            "name": "Active Known Customers",
            "expression": "CALCULATE(DISTINCTCOUNT(Sales[customer_id]), Sales[customer_id] <> \"UNKNOWN\")",
            "formatString": "#,##0"
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE(SUM(Sales[revenue]), [Orders])",
            "formatString": "\u00a3#,##0.00"
          },
          {
            "name": "Repeat Order Revenue",
            "expression": "CALCULATE(SUM(Sales[revenue]), Sales[is_repeat_order] = 1)",
            "formatString": "\u00a3#,##0.00"
          },
          {
            "name": "Repeat Buyer Share",
            "expression": "VAR Known = FILTER(VALUES(Sales[customer_id]), Sales[customer_id] <> \"UNKNOWN\") RETURN DIVIDE(COUNTROWS(FILTER(Known, CALCULATE(COUNTROWS(Sales)) >= 2)), COUNTROWS(Known))",
            "formatString": "0.0%"
          }
        ]
      },
      {
        "name": "DailySales",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none"
          },
          {
            "name": "gross_sales",
            "dataType": "double",
            "sourceColumn": "gross_sales",
            "summarizeBy": "none"
          },
          {
            "name": "orders",
            "dataType": "double",
            "sourceColumn": "orders",
            "summarizeBy": "none"
          },
          {
            "name": "units",
            "dataType": "double",
            "sourceColumn": "units",
            "summarizeBy": "none"
          },
          {
            "name": "credits",
            "dataType": "double",
            "sourceColumn": "credits",
            "summarizeBy": "none"
          },
          {
            "name": "net_invoiced_sales",
            "dataType": "double",
            "sourceColumn": "net_invoiced_sales",
            "summarizeBy": "none"
          },
          {
            "name": "month",
            "dataType": "string",
            "sourceColumn": "month",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "DailySales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"/daily_sales.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),",
                "    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),",
                "    Typed = Table.TransformColumnTypes(Headers, {{\"date\", type datetime}, {\"gross_sales\", type number}, {\"orders\", type number}, {\"units\", type number}, {\"credits\", type number}, {\"net_invoiced_sales\", type number}, {\"month\", type text}}, \"en-GB\")",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Sales",
            "expression": "SUM(DailySales[gross_sales])",
            "formatString": "\u00a3#,##0.00"
          },
          {
            "name": "Credits",
            "expression": "SUM(DailySales[credits])",
            "formatString": "\u00a3#,##0.00"
          },
          {
            "name": "Net Invoiced Sales",
            "expression": "[Gross Sales] - [Credits]",
            "formatString": "\u00a3#,##0.00"
          }
        ]
      },
      {
        "name": "Calendar",
        "columns": [
          {
            "name": "date",
            "dataType": "dateTime",
            "sourceColumn": "date",
            "summarizeBy": "none"
          },
          {
            "name": "month",
